# ─── FRED API ───────────────────────────────────────────────
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ─── Supabase ────────────────────────────────────────────────
# Supabase 프로젝트 Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버·적재 전용 (클라이언트에 절대 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google AI Studio (AI 한줄평) ───────────────────────────
# 발급: https://aistudio.google.com/apikey
# 적재(npm run ingest) 시점에만 사용 — AI 발표 해석 한줄평 생성용.
# 서버·적재 전용. 클라이언트·웹 런타임에 절대 노출 금지.
# 없으면 한줄평 생성만 스킵되고 적재는 정상 동작.
GEMINI_API_KEY=
