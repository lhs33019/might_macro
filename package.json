{
  "name": "ppi-inspire-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test lib/analytics/*.test.ts",
    "ingest": "node --env-file=.env.local --import tsx scripts/ingest.ts",
    "ingest:retry": "node --env-file=.env.local --import tsx scripts/ingest.ts -- --retry",
    "ingest:headline": "node --env-file=.env.local --import tsx scripts/ingest.ts -- --headline-only",
    "ingest:incremental": "node --env-file=.env.local --import tsx scripts/ingest.ts -- --incremental",
    "ingest:update": "node --env-file=.env.local --import tsx scripts/ingest.ts -- --headline-only --incremental",
    "ingest:consensus": "node --env-file=.env.local --import tsx scripts/seed-consensus.ts"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "claude": "^0.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
